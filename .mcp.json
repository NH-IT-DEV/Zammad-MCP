{
  "mcpServers": {
    "zammad": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/NH-IT-DEV/Zammad-MCP@e32d481a58f0731f5fbbcc382256ce4cb89709e6",
        "mcp-zammad"
      ],
      "env": {
        "ZAMMAD_URL": "${ZAMMAD_URL}",
        "ZAMMAD_HTTP_TOKEN": "${ZAMMAD_HTTP_TOKEN}"
      }
    }
  }
}
