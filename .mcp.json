{
  "mcpServers": {
    "zammad": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/NH-IT-DEV/Zammad-MCP@6a67e004320089c96a4a63c7df0282d1ed580be7",
        "mcp-zammad"
      ],
      "env": {
        "ZAMMAD_URL": "${ZAMMAD_URL}",
        "ZAMMAD_HTTP_TOKEN": "${ZAMMAD_HTTP_TOKEN}"
      }
    }
  }
}
